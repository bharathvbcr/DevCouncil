{"type":"match","data":{"path":{"text":"./benchmarks/results/competition/20260912-expanded/callers-devmap-describe_corpus-2.stdout"},"lines":{"text":"{\"blast_radius\":{\"layers\":{\"hidden\":0,\"items\":[{\"depth\":1,\"lowest_confidence\":1.0,\"node_count\":2,\"nodes\":[\"benchmarks/map_bench.py\",\"benchmarks/map_bench.py::main\"],\"nodes_omitted\":0}],\"resolution\":\"Available\",\"shown\":1,\"source_freshness\":{\"fresh\":null,\"reason\":\"whole-tree source freshness was not checked for this answer\"},\"tokens_used\":23,\"total\":1,\"truncated\":false,\"walk_incomplete\":\"91784 of 162590 unresolved attribution site(s) have no indexed target after excluding 70806 known builtin, runtime-global, and external-import site(s); these repository-wide counts are not specific to this target, so this answer may omit callers or dependencies that name it\"},\"seeds\":[\"benchmarks/map_bench.py::describe_corpus\"],\"total_impacted\":2,\"unmatched_targets\":[]},\"budget\":{\"blast_radius\":2000,\"definitions\":4000,\"edges_per_direction\":1000,\"total\":8000},\"definitions\":{\"hidden\":0,\"items\":[{\"callees\":{\"hidden\":0,\"items\":[],\"resolution\":{\"Unavailable\":{\"reason\":\"benchmarks/map_bench.py::describe_corpus has no indexed traversal start\"}},\"shown\":0,\"source_freshness\":{\"fresh\":null,\"reason\":\"no persisted generation is available to verify against the working tree\"},\"tokens_used\":0,\"total\":0,\"truncated\":false,\"walk_incomplete\":\"91784 of 162590 unresolved attribution site(s) have no indexed target after excluding 70806 known builtin, runtime-global, and external-import site(s); these repository-wide counts are not specific to this target, so this answer may omit callers or dependencies that name it\"},\"callers\":{\"hidden\":0,\"items\":[{\"confidence\":1.0,\"details\":null,\"edge_kind\":\"Calls\",\"evidence\":{\"kind\":\"SameFile\",\"source\":\"Stored\"},\"resolution\":null,\"source_file\":\"benchmarks/map_bench.py\",\"source_symbol\":\"benchmarks/map_bench.py::main\",\"target_file\":\"benchmarks/map_bench.py\",\"target_symbol\":\"benchmarks/map_bench.py::describe_corpus\"}],\"resolution\":\"Available\",\"rungs\":{\"deterministic\":1,\"filtered_out\":0,\"high\":0,\"speculative\":0},\"shown\":1,\"source_freshness\":{\"fresh\":null,\"reason\":\"whole-tree source freshness was not checked for this answer\"},\"tokens_used\":25,\"total\":1,\"truncated\":false,\"walk_incomplete\":\"the walk did not complete: stopped at depth 1; the result is a lower bound, not the full blast radius; 91784 of 162590 unresolved attribution site(s) have no indexed target after excluding 70806 known builtin, runtime-global, and external-import site(s); these repository-wide counts are not specific to this target, so this answer may omit callers or dependencies that name it\"},\"file_path\":\"benchmarks/map_bench.py\",\"id\":\"benchmarks/map_bench.py::describe_corpus\",\"kind\":\"Function\",\"language\":\"python\",\"qualified_name\":\"benchmarks/map_bench.py::describe_corpus\",\"score\":1.0,\"source\":\"def describe_corpus(repo: Path) -> Dict[str, object]:\\n    \\\"\\\"\\\"Count tracked files and code files so throughput has a denominator.\\n\\n    Falls back to a filesystem walk outside a git repository — the engine\\n    indexes trees, not just checkouts, and a benchmark that only runs on git\\n    repos cannot measure the case it is most often asked about.\\n    \\\"\\\"\\\"\\n    try:\\n        out = subprocess.run(\\n            [\\\"git\\\", \\\"ls-files\\\"], cwd=str(repo), capture_output=True, text=True, timeout=120\\n        )\\n        files = [f for f in out.stdout.splitlines() if f] if out.returncode == 0 else []\\n    except (OSError, subprocess.SubprocessError):\\n        files = []\\n    if not files:\\n        files = [\\n            str(p.relative_to(repo))\\n            for p in repo.rglob(\\\"*\\\")\\n            if p.is_file() and \\\".git\\\" not in p.parts\\n        ]\\n    code = [f for f in files if Path(f).suffix.lower() in _CODE_SUFFIXES]\\n    total_bytes = 0\\n    for rel in code:\\n        try:\\n            total_bytes += (repo / rel).stat().st_size\\n        except OSError:\\n            pass\\n    return {\\n        \\\"tracked_files\\\": len(files),\\n        \\\"code_files\\\": len(code),\\n        \\\"code_bytes\\\": total_bytes,\\n    }\",\"span\":[240,271],\"symbol_name\":\"describe_corpus\"}],\"resolution\":\"Available\",\"shown\":1,\"source_freshness\":{\"fresh\":null,\"reason\":\"whole-tree source freshness was not checked for this answer\"},\"tokens_used\":333,\"total\":1,\"truncated\":false},\"limit\":20,\"query\":\"describe_corpus\"}\n"},"line_number":1,"absolute_offset":0,"submatches":[{"match":{"text":"describe_corpus"},"start":701,"end":716},{"match":{"text":"describe_corpus"},"start":985,"end":1000},{"match":{"text":"describe_corpus"},"start":1823,"end":1838},{"match":{"text":"describe_corpus"},"start":2565,"end":2580},{"match":{"text":"describe_corpus"},"start":2663,"end":2678},{"match":{"text":"describe_corpus"},"start":2706,"end":2721},{"match":{"text":"describe_corpus"},"start":3961,"end":3976},{"match":{"text":"describe_corpus"},"start":4187,"end":4202}]}}
