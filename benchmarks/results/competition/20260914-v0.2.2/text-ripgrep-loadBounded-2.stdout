ferent places.\\n\\t\\tif errors.Is(err, ErrUnknownCompactLayout) {\\n\\t\\t\\treturn nil, fmt.Errorf(\\\"repomap: %s: %w\\\", graphPath, err)\\n\\t\\t}\\n\\t\\treturn nil, fmt.Errorf(\\\"repomap: %s is not a code graph: %w\\\", graphPath, err)\\n\\t}\\n\\tif len(g.Nodes) == 0 {\\n\\t\\treturn nil, fmt.Errorf(\\\"repomap: %s holds no nodes; the index has not been built\\\", graphPath)\\n\\t}\\n\\treturn build(g), nil\\n}\",\"span\":[331,357],\"symbol_name\":\"loadBounded\"}],\"resolution\":\"Available\",\"shown\":1,\"source_freshness\":{\"fresh\":null,\"reason\":\"whole-tree source freshness was not checked for this answer\"},\"tokens_used\":285,\"total\":1,\"truncated\":false},\"limit\":20,\"query\":\"loadBounded\"}\n"},"line_number":1,"absolute_offset":0,"submatches":[{"match":{"text":"loadBounded"},"start":6436,"end":6447},{"match":{"text":"loadBounded"},"start":6894,"end":6905},{"match":{"text":"loadBounded"},"start":7286,"end":7297},{"match":{"text":"loadBounded"},"start":7665,"end":7676},{"match":{"text":"loadBounded"},"start":8046,"end":8057},{"match":{"text":"loadBounded"},"start":9294,"end":9305},{"match":{"text":"loadBounded"},"start":9674,"end":9685},{"match":{"text":"loadBounded"},"start":10450,"end":10461},{"match":{"text":"loadBounded"},"start":10559,"end":10570},{"match":{"text":"loadBounded"},"start":10599,"end":10610},{"match":{"text":"loadBounded"},"start":11687,"end":11698},{"match":{"text":"loadBounded"},"start":11909,"end":11920}]}}
