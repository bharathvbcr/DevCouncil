{"type":"match","data":{"path":{"text":"./benchmarks/results/competition/20260913-48cd3c7/version-control-48cd3c7-search-loadBounded-1.stdout"},"lines":{"text":"{\"hidden\":0,\"items\":[{\"file_path\":\"backend/go_orchestrator/repomap/repomap.go\",\"kind\":\"Function\",\"score\":1.0,\"source_span\":\"func loadBounded(graphPath string, max int64) (*Map, error) {\\n\\tfile, err := os.Open(graphPath)\\n\\tif err != nil {\\n\\t\\treturn nil, fmt.Errorf(\\\"repomap: reading %s: %w\\\", graphPath, err)\\n\\t}\\n\\tdefer file.Close()\\n\\n\\traw, err := readBounded(file, max)\\n\\tif err != nil {\\n\\t\\treturn nil, fmt.Errorf(\\\"repomap: reading %s: %w\\\", graphPath, err)\\n\\t}\\n\\tg, err := decodeGraph(raw)\\n\\tif err != nil {\\n\\t\\t// A layout this build cannot read is a different report from a file it\\n\\t\\t// cannot parse, and keeping them apart is the difference between \\\"the\\n\\t\\t// producer moved ahead of this harness\\\" and \\\"the artifact is damaged\\\".\\n\\t\\t// They send an operator to different places.\\n\\t\\tif errors.Is(err, ErrUnknownCompactLayout) {\\n\\t\\t\\treturn nil, fmt.Errorf(\\\"repomap: %s: %w\\\", graphPath, err)\\n\\t\\t}\\n\\t\\treturn nil, fmt.Errorf(\\\"repomap: %s is not a code graph: %w\\\", graphPath, err)\\n\\t}\\n\\tif len(g.Nodes) == 0 {\\n\\t\\treturn nil, fmt.Errorf(\\\"repomap: %s holds no nodes; the index has not been built\\\", graphPath)\\n\\t}\\n\\treturn build(g), nil\\n}\",\"span\":[331,357],\"symbol_name\":\"loadBounded\"}],\"resolution\":\"Available\",\"shown\":1,\"source_freshness\":{\"fresh\":null,\"reason\":\"whole-tree source freshness was not checked for this answer; run `devmap status` (or call `devmap_status`) for a verified verdict\"},\"tokens_used\":265,\"total\":1,\"truncated\":false}\n"},"line_number":1,"absolute_offset":0,"submatches":[{"match":{"text":"loadBounded"},"start":129,"end":140},{"match":{"text":"loadBounded"},"start":1217,"end":1228}]}}
