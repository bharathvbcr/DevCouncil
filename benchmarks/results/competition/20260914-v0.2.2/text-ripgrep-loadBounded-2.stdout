 build cannot read is a different report from a file it\\n\\t\\t// cannot parse, and keeping them apart is the difference between \\\"the\\n\\t\\t// producer moved ahead of this harness\\\" and \\\"the artifact is damaged\\\".\\n\\t\\t// They send an operator to different places.\\n\\t\\tif errors.Is(err, ErrUnknownCompactLayout) {\\n\\t\\t\\treturn nil, fmt.Errorf(\\\"repomap: %s: %w\\\", graphPath, err)\\n\\t\\t}\\n\\t\\treturn nil, fmt.Errorf(\\\"repomap: %s is not a code graph: %w\\\", graphPath, err)\\n\\t}\\n\\tif len(g.Nodes) == 0 {\\n\\t\\treturn nil, fmt.Errorf(\\\"repomap: %s holds no nodes; the index has not been built\\\", graphPath)\\n\\t}\\n\\treturn build(g), nil\\n}\",\"span\":[331,357],\"symbol_name\":\"loadBounded\"}],\"resolution\":\"Available\",\"shown\":1,\"source_freshness\":{\"fresh\":null,\"reason\":\"whole-tree source freshness was not checked for this answer\"},\"tokens_used\":285,\"total\":1,\"truncated\":false},\"limit\":20,\"query\":\"loadBounded\"}\n"},"line_number":1,"absolute_offset":0,"submatches":[{"match":{"text":"loadBounded"},"start":6525,"end":6536},{"match":{"text":"loadBounded"},"start":6983,"end":6994},{"match":{"text":"loadBounded"},"start":7375,"end":7386},{"match":{"text":"loadBounded"},"start":7754,"end":7765},{"match":{"text":"loadBounded"},"start":8135,"end":8146},{"match":{"text":"loadBounded"},"start":9472,"end":9483},{"match":{"text":"loadBounded"},"start":9852,"end":9863},{"match":{"text":"loadBounded"},"start":10717,"end":10728},{"match":{"text":"loadBounded"},"start":10826,"end":10837},{"match":{"text":"loadBounded"},"start":10866,"end":10877},{"match":{"text":"loadBounded"},"start":11954,"end":11965},{"match":{"text":"loadBounded"},"start":12176,"end":12187}]}}
