{"type":"match","data":{"path":{"text":"./benchmarks/results/competition/20260913-48cd3c7/caller-source-evidence.json"},"lines":{"text":"    \"source\": \"            db_size_gate_steady_bytes(10_000),\\n            3_604_480_000,\\n            \\\"steady-state budget doubles the per-generation one\\\"\\n        );\\n        assert_eq!(DB_SIZE_GATE_FLOOR, 62_914_560, \\\"60 MiB floor\\\");\\n        // The floor covers repositories up to 349 files at 176 KiB/file; past\\n        // that the per-file budget takes over (was 384 files at 160 KiB).\\n        assert_eq!(\\n            db_size_gate_bytes(100),\\n            DB_SIZE_GATE_FLOOR,\\n            \\\"floor dominates small repos\\\"\\n        );\\n        assert_eq!(\\n            db_size_gate_bytes(349),\\n            DB_SIZE_GATE_FLOOR,\\n            \\\"the crossover stays on the floor\\\"\\n        );\\n        assert_eq!(\\n            db_size_gate_bytes(350),\\n            63_078_400,\\n            \\\"one file past the crossover scales\\\"\\n        );\\n        assert_eq!(\\n            db_size_gate_bytes(10_000),\\n            1_802_240_000,\\n            \\\"per-file dominates large repos\\\"\\n        );\\n    }\\n\\n    /// `binding_pairs` reverses each `(imported, local)` into `(local, imported)`\\n    /// and drops nothing.\\n    ///\\n    /// The whole body was replaceable with `vec![]` and with a single blank\"\n"},"line_number":6,"absolute_offset":100,"submatches":[{"match":{"text":"db_size_gate_bytes"},"start":431,"end":449},{"match":{"text":"db_size_gate_bytes"},"start":580,"end":598},{"match":{"text":"db_size_gate_bytes"},"start":734,"end":752},{"match":{"text":"db_size_gate_bytes"},"start":882,"end":900}]}}
{"type":"match","data":{"path":{"text":"./benchmarks/results/competition/20260913-48cd3c7/caller-source-evidence.json"},"lines":{"text":"    \"source\": \"#[test]\\nfn db_size_gate_scales_with_file_count_and_keeps_a_floor() {\\n    // Derived from the constant, not a repeated literal: the two drifted once\\n    // already (SC15), and a test that restates the number cannot notice.\\n    let floor = devmap_extract::model::DB_SIZE_GATE_FLOOR;\\n    let per_file = devmap_extract::model::DB_SIZE_GATE_PER_FILE;\\n    let floor_files = floor / per_file;\\n\\n    assert_eq!(db_size_gate_bytes(0), floor, \\\"an empty repo gets the floor\\\");\\n    assert_eq!(\\n        db_size_gate_bytes(floor_files),\\n        floor,\\n        \\\"at the crossover the floor still wins\\\"\\n    );\\n    assert_eq!(\\n        db_size_gate_bytes(floor_files + 1),\\n        (floor_files + 1) * per_file,\\n        \\\"past the crossover the budget scales per file\\\"\\n    );\\n    assert!(db_size_gate_bytes(15_000) > floor);\\n    // Saturating: a pathological count must not wrap to a tiny budget.\\n    assert!(db_size_gate_bytes(u64::MAX) >= floor);\"\n"},"line_number":12,"absolute_offset":1424,"submatches":[{"match":{"text":"db_size_gate_bytes"},"start":425,"end":443},{"match":{"text":"db_size_gate_bytes"},"start":516,"end":534},{"match":{"text":"db_size_gate_bytes"},"start":650,"end":668},{"match":{"text":"db_size_gate_bytes"},"start":806,"end":824},{"match":{"text":"db_size_gate_bytes"},"start":929,"end":947}]}}
{"type":"end","data":{"path":{"text":"./benchmarks/results/competition/20260913-48cd3c7/caller-source-evidence.json"},"binary_offset":null,"stats":{"elapsed":{"secs":0,"nanos":7792,"human":"0.000008s"},"searches":1,"searches_with_match":1,"bytes_searched":5794,"bytes_printed":3348,"matched_lines":2,"matches":9}}}
