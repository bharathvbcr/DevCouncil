{"hidden":0,"items":[{"file_path":"benchmarks/map_bench.py","kind":"Function","score":1.0,"source_span":"def describe_corpus(repo: Path) -> Dict[str, object]:\n    \"\"\"Count tracked files and code files so throughput has a denominator.\n\n    Falls back to a filesystem walk outside a git repository — the engine\n    indexes trees, not just checkouts, and a benchmark that only runs on git\n    repos cannot measure the case it is most often asked about.\n    \"\"\"\n    try:\n        out = subprocess.run(\n            [\"git\", \"ls-files\"], cwd=str(repo), capture_output=True, text=True, timeout=120\n        )\n        files = [f for f in out.stdout.splitlines() if f] if out.returncode == 0 else []\n    except (OSError, subprocess.SubprocessError):\n        files = []\n    if not files:\n        files = [\n            str(p.relative_to(repo))\n            for p in repo.rglob(\"*\")\n            if p.is_file() and \".git\" not in p.parts\n        ]\n    code = [f for f in files if Path(f).suffix.lower() in _CODE_SUFFIXES]\n    total_bytes = 0\n    for rel in code:\n        try:\n            total_bytes += (repo / rel).stat().st_size\n        except OSError:\n            pass\n    return {\n        \"tracked_files\": len(files),\n        \"code_files\": len(code),\n        \"code_bytes\": total_bytes,\n    }","span":[240,271],"symbol_name":"describe_corpus"}],"resolution":"Available","shown":1,"source_freshness":{"fresh":null,"reason":"whole-tree source freshness was not checked for this answer; run `devmap status` (or call `devmap_status`) for a verified verdict"},"tokens_used":313,"total":1,"truncated":false}
