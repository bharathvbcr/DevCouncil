{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "devcouncil": {
      "type": "local",
      "command": [
        "devcouncil",
        "mcp-server"
      ],
      "environment": {
        "DEVCOUNCIL_PROJECT_ROOT": "/Users/bharath/Code/devtools/DevCouncil"
      },
      "enabled": true,
      "timeout": 10000
    },
    "devmap": {
      "type": "local",
      "command": [
        "devmap",
        "--db",
        "/Users/bharath/Code/devtools/DevCouncil/.devcouncil/codeintel/devmap.sqlite",
        "mcp"
      ],
      "enabled": true,
      "timeout": 10000
    }
  },
  "plugin": [
    "./.devcouncil/integrations/opencode_devcouncil_plugin.mjs"
  ]
}
