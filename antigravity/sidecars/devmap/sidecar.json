{
  "command": "devmap",
  "args": ["mcp", "--http", "127.0.0.1:9095"],
  "description": "Read-only repo map: subsystems, entry points, neighbors and liveness, served by the DevMap HTTP transport from the repository's built map",
  "display_name": "DevMap Code Graph Explorer",
  "has_web_ui": true,
  "restart_policy": "always",
  "ui_config": {
    "display_name": "DevMap Code Graph Explorer",
    "views": [
      {
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "path": "/map_preview.html",
        "title": "Code Graph Explorer"
      }
    ]
  }
}
