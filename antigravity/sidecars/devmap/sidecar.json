{
  "command": "devmap",
  "args": ["serve", "--ui-sidecar", "--port", "9095"],
  "description": "Interactive force-directed code graph visualizer and blast-radius inspector",
  "display_name": "DevMap Code Graph Explorer",
  "has_web_ui": true,
  "restart_policy": "always",
  "ui_config": {
    "display_name": "DevMap Code Graph Explorer",
    "views": [
      {
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "path": "/map_preview.html",
        "title": "Code Graph Explorer"
      }
    ]
  }
}
